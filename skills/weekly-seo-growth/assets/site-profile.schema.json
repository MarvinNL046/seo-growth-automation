{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/weekly-seo-growth/site-profile.schema.json",
  "title": "Weekly SEO growth site profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "domain",
    "niche",
    "locale",
    "repository",
    "publicationPolicy",
    "measurement",
    "dataForSEO",
    "commands",
    "sourcePolicy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
    "niche": { "type": "string", "minLength": 2 },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locationCode", "languageCode", "marketLabel"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
        "locationCode": { "type": "integer", "minimum": 1 },
        "languageCode": { "type": "string", "pattern": "^[a-z]{2}$" },
        "marketLabel": { "type": "string", "minLength": 2 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectPath", "remote", "defaultBranch", "productionBranch", "hosting", "rollbackDocumented"],
      "properties": {
        "projectPath": { "type": "string", "minLength": 3 },
        "remote": { "type": "string", "minLength": 3 },
        "defaultBranch": { "type": "string", "minLength": 1 },
        "productionBranch": { "type": "string", "minLength": 1 },
        "hosting": { "type": "string", "minLength": 1 },
        "rollbackDocumented": { "type": "boolean" }
      }
    },
    "publicationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "permanentPrOnly", "initialPrOnlyRuns", "maxActionsPerRun"],
      "properties": {
        "mode": { "const": "pr-only" },
        "permanentPrOnly": { "type": "boolean" },
        "initialPrOnlyRuns": { "type": "integer", "minimum": 3 },
        "maxActionsPerRun": { "const": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gscStatus", "gscProperty", "baselineWindowsDays"],
      "properties": {
        "gscStatus": { "enum": ["configured", "export-only", "unavailable"] },
        "gscProperty": { "type": "string" },
        "baselineWindowsDays": {
          "type": "array",
          "prefixItems": [{ "const": 28 }, { "const": 56 }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "dataForSEO": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seedKeywords", "minSearchVolume", "maxKeywordDifficulty", "ideaLimit", "subjectPattern", "excludePattern", "deepValidationMinimum"],
      "properties": {
        "seedKeywords": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1 } },
        "minSearchVolume": { "type": "integer", "minimum": 0 },
        "maxKeywordDifficulty": { "type": "number", "minimum": 0, "maximum": 100 },
        "ideaLimit": { "type": "integer", "minimum": 1, "maximum": 700 },
        "subjectPattern": { "type": "string", "minLength": 1 },
        "excludePattern": { "type": "string" },
        "deepValidationMinimum": { "type": "integer", "minimum": 3, "maximum": 10 }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "test", "build"],
      "properties": {
        "install": { "type": "string", "minLength": 1 },
        "test": { "type": "string", "minLength": 1 },
        "typecheck": { "type": "string" },
        "build": { "type": "string", "minLength": 1 },
        "renderedHtml": { "type": "string" },
        "lighthouse": { "type": "string" }
      }
    },
    "sourcePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ymyl", "primarySourceRequired", "preferredDomains", "forbiddenClaims"],
      "properties": {
        "ymyl": { "type": "boolean" },
        "primarySourceRequired": { "type": "boolean" },
        "preferredDomains": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "forbiddenClaims": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
